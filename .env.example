# Mob Graphwar hosted provider settings.
# Offline local play works with no environment variables.

PORT=3000
HOST=0.0.0.0

GRAPHWAR_ALLOWED_PROVIDERS=openrouter,infron,openai,anthropic,gemini,xai,moonshot,zhipu,deepseek,stepfun,minimax,mimo
GRAPHWAR_DEFAULT_PROVIDER=openrouter
GRAPHWAR_REQUEST_TIMEOUT_MS=300000
GRAPHWAR_RATE_LIMIT_PER_MINUTE=30
GRAPHWAR_SESSION_SECRET=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

INFRON_API_KEY=
INFRON_BASE_URL=https://llm.onerouter.pro/v1
INFRON_MODEL=openai/gpt-5.5

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-build-0.1

MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k2.6

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.ai/v1
STEPFUN_MODEL=step-3.7-flash

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3

MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

ZHIPU_API_KEY=
ZAI_API_KEY=
ZHIPU_BASE_URL=https://api.z.ai/api/paas/v4
ZHIPU_MODEL=glm-5.2
