# Mob Graphwar hosted provider settings.
# Offline local play works with no environment variables.

PORT=3000
HOST=0.0.0.0

GRAPHWAR_ALLOWED_PROVIDERS=openai,deepseek,minimax,zhipu,anthropic
GRAPHWAR_DEFAULT_PROVIDER=deepseek
GRAPHWAR_REQUEST_TIMEOUT_MS=20000
GRAPHWAR_RATE_LIMIT_PER_MINUTE=30

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M1

ZHIPU_API_KEY=
ZAI_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
