# Mob Graphwar hosted provider settings.
# Offline local play works with no environment variables.

PORT=3000
HOST=0.0.0.0

GRAPHWAR_ALLOWED_PROVIDERS=openrouter,openai,anthropic,gemini,xai,moonshot,zhipu,deepseek,stepfun,minimax
GRAPHWAR_DEFAULT_PROVIDER=openrouter
GRAPHWAR_REQUEST_TIMEOUT_MS=20000
GRAPHWAR_RATE_LIMIT_PER_MINUTE=30

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.5-flash

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.3

MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k2.7

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.ai/v1
STEPFUN_MODEL=step-3.7-flash

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M1

ZHIPU_API_KEY=
ZAI_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4-flash
