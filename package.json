{
  "name": "mob-graphwar-arena",
  "version": "0.1.0",
  "private": true,
  "description": "A ranked AI-command function artillery arena.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/index.js",
    "benchmark:openrouter:raw": "node scripts/openrouter-raw-benchmark.js --games-per-pair=2 --max-actions=24 --concurrency=8 --timeout-ms=300000 --write-store=.data/graphwar-store.json",
    "benchmark:infron:raw": "node scripts/openrouter-raw-benchmark.js --platform=infron --games-per-pair=2 --max-actions=24 --concurrency=8 --timeout-ms=300000 --write-store=.data/graphwar-store.json",
    "test": "node test/sim-core.test.js && node test/agent-contract.test.js && node test/provider-catalog.test.js && node test/server.test.js && node test/openrouter-benchmark.test.js && node test/ui-source.test.js && vitest run test/ui-render.test.jsx",
    "test:ui": "vitest run test/ui-render.test.jsx",
    "test:real:deepseek": "node test/real-deepseek-smoke.js",
    "test:real:openrouter": "node test/real-openrouter-smoke.js"
  },
  "license": "MIT",
  "dependencies": {
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.2.0",
    "caniuse-lite": "1.0.30001800",
    "jsdom": "^26.1.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.6"
  }
}
